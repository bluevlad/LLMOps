# LLMOps — 환경변수 예제
# 실제 값은 .env (gitignore 됨) 또는 docker-compose 환경변수로 주입

# --- App ---
APP_ENV=dev                       # dev / staging / prod
APP_DEBUG=true
APP_TZ=Asia/Seoul

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=9110
BACKEND_CORS_ORIGINS=http://localhost:4110,https://llmops.unmong.com

# --- Frontend (Vite) ---
# 프로덕션/Docker: 비워둘 것 → 브라우저는 상대경로 /api 로 요청, nginx 가 백엔드로 프록시.
#   (값을 http://localhost:9110 로 두면 그 문자열이 번들에 박혀 방문자 PC localhost 로 향함 → Network Error + mixed-content)
# 로컬 dev 단독 실행 시에도 비워두면 vite dev 프록시(VITE_PROXY_TARGET→localhost:9110)가 처리.
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=             # Google Identity Services 버튼 (백엔드 GOOGLE_OAUTH_CLIENT_ID 와 동일)

# --- Database (PostgreSQL 공유 컨테이너) ---
# 컨테이너 내: host=postgresql (database-network)
# 로컬: host=localhost (5432 호스트 노출)
DATABASE_URL=postgresql+asyncpg://llmops_svc:CHANGE_ME@localhost:5432/llmops_dev
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Google OAuth (ID Token flow) ---
# llmops.unmong.com 으로 등록된 OAuth Client 사용
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=https://llmops.unmong.com/auth/callback

# --- 권한 (admin allowlist) ---
# 콤마 구분 이메일 목록. 목록의 계정만 llmops_admin, 그 외 로그인은 전부 llmops_guest
# (데이터 API 접근 불가, 로그인 이력만 기록)
LLMOPS_ADMIN_EMAILS=

# --- LLM Sources (Phase 1b 이후) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
# 호스트의 HuggingFace 캐시 루트 (docker-compose 볼륨 마운트 소스)
HOST_HF_CACHE=~/.cache/huggingface
# 컨테이너 내 스캔 경로 (docker-compose 가 /host/... 로 마운트). 비우면 MLX 스캔 skip
MLX_MODEL_DIR=/host/.cache/huggingface/hub
POLLER_OLLAMA_INTERVAL_SECONDS=600   # 10분
POLLER_MLX_INTERVAL_SECONDS=3600     # 1시간

# --- LLMOps API Keys (consumer 서비스 → batch_runs 보고용, Phase 2 이후) ---
# 형식: consumer_id:api_key (JSON object 또는 base64 등 — Phase 1b 에서 확정)
LLMOPS_INGEST_KEYS={}

# --- 관제 알림 (v0.3.0 M3) ---
# Slack incoming webhook. 비우면 DB 기록만 하고 발송하지 않는다 (화면에는 그대로 보임).
SLACK_WEBHOOK_URL=
# Ollama 에 항상 상주해 있어야 하는 모델 (콤마 구분). 비면 상주 이탈 알림 없음.
EXPECTED_RESIDENT_MODELS=
ALERT_EVAL_INTERVAL_SECONDS=600     # 알림 평가 주기 (0 = 비활성)
ALERT_FAIL_RATE_THRESHOLD=0.2       # 24h 실패율 임계
ALERT_FAIL_MIN_COUNT=3              # 최소 실패 건수 (표본 적을 때 오탐 방지)

# --- S2S 읽기 키 (v0.3.0) — DocPipeline 등이 읽기 API 를 pull 할 때 X-API-Key 로 인증 ---
# JSON object {client_id: api_key}. ingest 키와 별도. DocPipeline .env.production 의 LLMOPS_API_KEY 와 같은 값.
LLMOPS_READ_KEYS={}
